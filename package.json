{
  "name": "@anantduhan/limiter-core",
  "version": "1.0.0",
  "description": "Production-grade distributed rate limiter for Node.js. Same API for memory and Redis — swap backends with one config change.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "prepublishOnly": "npm run build && npm test",
    "dev": "tsc --watch"
  },
  "keywords": [
    "rate-limit",
    "ratelimit",
    "rate-limiter",
    "token-bucket",
    "sliding-window",
    "redis",
    "throttle",
    "express",
    "fastify",
    "distributed",
    "middleware"
  ],
  "author": {
    "name": "Anant Duhan",
    "url": "https://github.com/AnantDuhan"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AnantDuhan/limiter-core.git"
  },
  "bugs": {
    "url": "https://github.com/AnantDuhan/limiter-core/issues"
  },
  "homepage": "https://github.com/AnantDuhan/limiter-core#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "redis": ">=4.0.0",
    "express": ">=4.0.0",
    "fastify": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "redis": { "optional": true },
    "express": { "optional": true },
    "fastify": { "optional": true }
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/jest": "29.5.14",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.0",
    "express": "^4.18.0",
    "fastify": "^4.28.0",
    "fastify-plugin": "^4.5.0",
    "jest": "29.7.0",
    "redis": "^4.6.0",
    "supertest": "^6.3.0",
    "ts-jest": "29.4.12",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.ts"],
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", { "tsconfig": "tsconfig.json" }]
    }
  }
}
