{
  "name": "@limiter/core",
  "version": "0.1.0",
  "description": "Production-grade rate limiter for Node.js with Memory and Redis backends",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "dev": "tsc --watch"
  },
  "keywords": ["rate-limit", "ratelimit", "token-bucket", "redis", "throttle"],
  "author": "Anant Duhan",
  "license": "MIT",
  "dependencies": {
    "redis": "^4.6.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.ts"],
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", { "tsconfig": "tsconfig.json" }]
    }
  }
}
